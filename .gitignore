node_modules/
*.log
data.sqlite-journal

# 环境变量（含 WECHAT_APPSECRET 等真实密钥）
.env

# 证书 / 上传密钥（小程序上传密钥 private.key 刻意放在项目外，这里只做兜底）
*.key
*.pem
*.p12
# release 签名 keystore 的 base64 导出物（哪怕空文件也不入库，避免误夹带密钥）
keystore.b64

# 本地数据库（含真实用户绑定数据）
data.sqlite

# Android 构建产物（keystore 绝不入库：公开仓库泄露等于应用可被冒名重签；
# CI 构建用默认 debug 签名，release 签名文件只留本地）
android/keystore/
android/.gradle/
android/app/build/
android/build/
android/captures/
android/local.properties
*.iml
.idea/

# WorkBuddy 工作数据（会话记忆，不属于源码）
.workbuddy/

# Git worktree 隔离工作区（多 agent 并行改同一仓库时用）
# 必须忽略：worktree 里是完整仓库副本，不排除的话会被 git 当成项目内容跟踪
.worktrees/

# 构建产物与演示库（均可用脚本重新生成，不进版本库）
dist/
*.apk
data.demo.sqlite

# wrangler CLI 本地状态（.wrangler 类似物，含本机部署缓存，与源码无关）
# 无斜杠形式：workers/wrangler 曾是个 0 字节误建文件，目录/文件都要挡住；
# 不会误伤 wrangler.jsonc（配置，需要跟踪）与 .wrangler（真实状态目录）
workers/wrangler

# 录音存证文件（含真实老人语音，隐私等级最高，绝不入库）
uploads/

# 录音音频：镜像 services/recordingStore.js 的 EXT_WHITELIST，
# 防止 adb pull / 手工导出时落到仓库任意目录后被误提交。
# 老人语音一旦进入 git 历史，仅靠后续删除是删不掉的（对象仍留在历史里），
# 只能重写历史 + 视为已泄露，所以这里按扩展名一律拦掉。
*.m4a
*.mp4
*.aac
*.mp3
*.amr
*.3gp
*.wav
*.ogg
*.opus

# 录音分段的中间/临时文件（实测会被 pull 到仓库根目录）
*.bin
recordings/

# 演示库
data.demo.sqlite

# CI 生成的 Release 正文临时文件
release-body.md

# 调试期 adb screencap 直接落在仓库根目录，一律不入库（只挡根目录，不影响 res/mipmap、小程序 icons 等子目录图）
/*.png
/*.jpg
/*.jpeg

# scripts/ 只放可复用脚本，调试截图一律不入库（历史上曾被 wx-*.png 夹带过）
scripts/**/*.png
# 小程序本机私有配置（订阅消息模板 ID 等平台资产，不进版本库）
wechat-miniprogram/config.local.js
