node_modules/
*.log
data.sqlite-journal

# 环境变量（含 WECHAT_APPSECRET 等真实密钥）
.env

# 证书 / 上传密钥（小程序上传密钥 private.key 刻意放在项目外，这里只做兜底）
*.key
*.pem
*.p12

# 本地数据库（含真实用户绑定数据）
data.sqlite

# Android 构建产物（keystore 绝不入库：公开仓库泄露等于应用可被冒名重签；
# CI 构建用默认 debug 签名，release 签名文件只留本地）
android/keystore/
android/.gradle/
android/app/build/
android/build/
android/captures/
android/local.properties
*.iml
.idea/

# WorkBuddy 工作数据（会话记忆，不属于源码）
.workbuddy/

# 构建产物与演示库（均可用脚本重新生成，不进版本库）
dist/
*.apk
data.demo.sqlite

# 录音存证文件（含真实老人语音，隐私等级最高，绝不入库）
uploads/

# 演示库
data.demo.sqlite
