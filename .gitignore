node_modules/
*.log
data.sqlite-journal

# 环境变量（含 WECHAT_APPSECRET 等真实密钥）
.env

# 证书 / 上传密钥（小程序上传密钥 private.key 刻意放在项目外，这里只做兜底）
*.key
*.pem
*.p12

# 本地数据库（含真实用户绑定数据）
data.sqlite

# Android 构建产物（keystore 绝不入库：公开仓库泄露等于应用可被冒名重签；
# CI 构建用默认 debug 签名，release 签名文件只留本地）
android/keystore/
android/.gradle/
android/app/build/
android/build/
android/captures/
android/local.properties
*.iml
.idea/

# WorkBuddy 工作数据（会话记忆，不属于源码）
.workbuddy/

# 构建产物与演示库（均可用脚本重新生成，不进版本库）
dist/
*.apk
data.demo.sqlite

# 录音存证文件（含真实老人语音，隐私等级最高，绝不入库）
uploads/

# 录音音频：镜像 services/recordingStore.js 的 EXT_WHITELIST，
# 防止 adb pull / 手工导出时落到仓库任意目录后被误提交。
# 老人语音一旦进入 git 历史，仅靠后续删除是删不掉的（对象仍留在历史里），
# 只能重写历史 + 视为已泄露，所以这里按扩展名一律拦掉。
*.m4a
*.mp4
*.aac
*.mp3
*.amr
*.3gp
*.wav
*.ogg
*.opus

# 录音分段的中间/临时文件（实测会被 pull 到仓库根目录）
*.bin
recordings/

# 演示库
data.demo.sqlite
