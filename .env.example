# ─────────────────────────────────────────────
#  逆地理编码：坐标 → 真实地名
# ─────────────────────────────────────────────
# 不配置也能跑：地址退化为「坐标 28.2738, 113.0616」，功能不崩，
# 但子女端看不到"老人在哪"，反诈价值大打折扣 —— 强烈建议配一个 key。
# 注意：Android端 SDK 的 AMAP_KEY 不能用于 Web 服务，需要单独申请
# 「Web服务」类型 key（https://console.amap.com → 应用管理 → 我的应用 → 添加 Key）。

# 留空则自动按 amap → tencent 顺序探测
# GEO_PROVIDER=amap

# 高德 Web服务 key（推荐，国内稳定、免费额度足够个人项目）
# AMAP_WEB_KEY=your_web_service_key

# 腾讯地图 key（备选）
# TENCENT_MAP_KEY=your_tencent_key

# 显式关闭（只用坐标，不查任何外部服务）
# GEO_PROVIDER=NONE

# 单次请求超时（毫秒）
# GEO_TIMEOUT_MS=5000

PORT=3000
WECHAT_APPID=your_appid_here
WECHAT_APPSECRET=your_appsecret_here

# 数据库路径（可选）：演示环境用 data.demo.sqlite（npm run seed 生成）
# DB_PATH=data.demo.sqlite

# ─────────────────────────────────────────────
#  环境录音存证：语音转写（ASR）
# ─────────────────────────────────────────────
# 不配置也能跑：录音照常上传存证，transcript_status 记为 SKIPPED，
# 证据临时保留（不会被当作"非诈骗"直接清掉），子女端可人工收听判断。

# 方案 A：任何 OpenAI 兼容的 /audio/transcriptions 接口
#   （OpenAI / 硅基流动 / Groq / 本地 whisper.cpp server 都可）
# ASR_PROVIDER=whisper
# ASR_BASE_URL=https://api.siliconflow.cn/v1
# ASR_API_KEY=your_key_here
# ASR_MODEL=FunAudioLLM/SenseVoiceSmall

# 方案 B：腾讯云一句话识别（国内网络更稳，需要登录腾讯云控制台）
# ASR_PROVIDER=tencent
# TENCENT_APP_ID=1250000000
# TENCENT_SECRET_ID=your_secret_id
# TENCENT_SECRET_KEY=your_secret_key
# TENCENT_ASR_ENGINE_TYPE=16k_zh

# ASR_TIMEOUT_MS=60000

# ─────────────────────────────────────────────
#  环境录音存证：大模型复核（可选）
# ─────────────────────────────────────────────
# 只有在规则引擎判定为"SAFE"且文本较长时才调用 LLM 兜底复核，
# 避免模型一次误判就让录音被长期钉在服务器上。
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your_key_here
# LLM_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────
#  环境录音存证：证据生命周期
# ─────────────────────────────────────────────
# 判定为"非诈骗(SAFE)"的录音保留天数，到期自动清理。
# 不设 0：老人可能正在被骗中，AI 一次误判就再也找不回原始录音，
# 必须留出人工复核窗口。
# RECORDING_SAFE_RETENTION_DAYS=14

# 到期扫描间隔（毫秒）
# RECORDING_CLEANUP_INTERVAL_MS=1800000

# 播放签名有效期（毫秒）。MediaPlayer 不带自定义头，收听录音走 URL 签名。
# PLAY_TOKEN_TTL_MS=1800000

# 播放签名密钥。不配置则每次启动随机生成，重启后旧链接自动失效。
# 固定配置可让子女端已拿到的链接跨重启继续可用。
# EVIDENCE_TOKEN_SECRET=your_long_random_string
