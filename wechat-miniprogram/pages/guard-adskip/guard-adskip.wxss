.container {
  padding: 24rpx;
  background: #0F172A;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #1E293B;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card-title {
  color: #F1F5F9;
  font-size: 32rpx;
  font-weight: 600;
}

.card-desc {
  color: #94A3B8;
  font-size: 26rpx;
  line-height: 1.7;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.switch-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  margin-right: 16rpx;
}

.switch-label {
  color: #F1F5F9;
  font-size: 30rpx;
  font-weight: 500;
}

.switch-sub {
  color: #64748B;
  font-size: 22rpx;
  line-height: 1.5;
}
