.header-card {
  display: flex;
  align-items: center;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 12px;
}

.avatar {
  font-size: 32px;
}

.name {
  font-size: 16px;
  font-weight: bold;
  display: block;
}

.status-tag {
  font-size: 12px;
  color: #34D399;
}

.danger-card {
  background: rgba(239, 68, 68, 0.15);
  border-color: rgba(239, 68, 68, 0.3);
}

.card-title {
  font-size: 16px;
  font-weight: bold;
  color: #FCA5A5;
  margin-bottom: 6px;
  display: block;
}

.card-desc {
  font-size: 12px;
  color: #94A3B8;
  margin-bottom: 12px;
  display: block;
}

.event-item {
  border-bottom: 1px solid rgba(255,255,255,0.05);
  padding: 8px 0;
}

.event-header {
  display: flex;
  justify-content: space-between;
}

.event-type {
  font-weight: bold;
  color: #F59E0B;
}

.event-type.high {
  color: #EF4444;
}

.event-time {
  font-size: 12px;
  color: #64748B;
}

.event-detail {
  font-size: 12px;
  color: #94A3B8;
  display: block;
  margin-top: 4px;
}
