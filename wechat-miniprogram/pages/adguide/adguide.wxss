/* 广告「源头关闭」指引页样式：沿用 app.wxss 暗色主题 token */
.container {
  padding: 16px;
}

.hero-card {
  border: 1px solid rgba(59, 130, 246, 0.35);
}

.card-desc {
  display: block;
  font-size: 13px;
  color: #CBD5E1;
  line-height: 1.7;
  margin-bottom: 8px;
}

.card-desc.tip {
  color: #93C5FD;
  margin-bottom: 0;
}

.center-box {
  text-align: center;
  padding: 32px 16px;
}

.muted {
  font-size: 13px;
  color: #94A3B8;
  line-height: 1.6;
}

.retry-btn {
  display: inline-block;
  margin-top: 12px;
  padding: 8px 28px;
  background: #3B82F6;
  color: #FFFFFF;
  font-size: 14px;
  border-radius: 8px;
}

/* 通用建议 */
.universal-item {
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.u-title {
  display: block;
  font-size: 14px;
  font-weight: bold;
  color: #E2E8F0;
  margin-bottom: 4px;
}

.u-text {
  display: block;
  font-size: 13px;
  color: #94A3B8;
  line-height: 1.7;
}

/* 品牌选择 */
.brand-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 8px;
}

.brand-chip {
  padding: 10px 14px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 12px;
  min-width: 104px;
  box-sizing: border-box;
}

.brand-chip.active {
  background: rgba(59, 130, 246, 0.2);
  border-color: #3B82F6;
}

.chip-name {
  display: block;
  font-size: 14px;
  font-weight: bold;
  color: #E2E8F0;
}

.brand-chip.active .chip-name {
  color: #93C5FD;
}

.chip-os {
  display: block;
  font-size: 11px;
  color: #64748B;
  margin-top: 2px;
}

/* 进度 */
.progress-card .progress-bar {
  height: 6px;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 3px;
  margin: 10px 0 6px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #22C55E;
  border-radius: 3px;
  transition: width 0.3s;
}

.progress-text {
  font-size: 12px;
  color: #64748B;
}

/* 步骤节 */
.sec-title {
  display: block;
  font-size: 15px;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 10px;
}

.path-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 8px;
  padding: 8px 10px;
  margin-bottom: 10px;
}

.path-text {
  font-size: 13px;
  color: #FBBF24;
  line-height: 1.5;
  flex: 1;
}

.path-hint {
  font-size: 11px;
  color: #64748B;
  margin-left: 8px;
  flex-shrink: 0;
}

/* 关闭项（带勾选） */
.off-item {
  display: flex;
  align-items: flex-start;
  padding: 8px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.off-item:last-of-type {
  border-bottom: none;
}

.checkbox {
  width: 18px;
  height: 18px;
  border-radius: 4px;
  border: 1.5px solid #64748B;
  margin: 2px 10px 0 0;
  flex-shrink: 0;
  box-sizing: border-box;
}

.checkbox.checked {
  background: #22C55E;
  border-color: #22C55E;
  position: relative;
}

.checkbox.checked::after {
  content: '';
  position: absolute;
  left: 5px;
  top: 1.5px;
  width: 4px;
  height: 9px;
  border: solid #FFFFFF;
  border-width: 0 2px 2px 0;
  transform: rotate(45deg);
}

.off-text {
  font-size: 13.5px;
  color: #E2E8F0;
  line-height: 1.6;
}

.off-text.done {
  color: #64748B;
  text-decoration: line-through;
}

/* 保留项 */
.keep-box {
  margin-top: 10px;
  padding: 8px 10px;
  background: rgba(148, 163, 184, 0.08);
  border-radius: 8px;
}

.keep-label {
  font-size: 12px;
  color: #94A3B8;
  font-weight: bold;
}

.keep-text {
  font-size: 12px;
  color: #94A3B8;
  line-height: 1.6;
}

/* 注意事项 */
.note-box {
  margin-top: 10px;
  padding: 8px 10px;
  background: rgba(251, 191, 36, 0.08);
  border-left: 3px solid #FBBF24;
  border-radius: 0 8px 8px 0;
}

.note-text {
  font-size: 12px;
  color: #FCD34D;
  line-height: 1.6;
}

.source-card {
  text-align: center;
}

/* 自动匹配提示 */
.auto-match-tip {
  margin-top: 8px;
  padding: 8px 10px;
  background: rgba(34, 197, 94, 0.1);
  border-left: 3px solid #22C55E;
  border-radius: 0 8px 8px 0;
}

.auto-match-text {
  font-size: 12px;
  color: #86EFAC;
  line-height: 1.6;
}
