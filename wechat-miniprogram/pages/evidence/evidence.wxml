<view class="container">
  <view class="card" wx:if="{{!isBound}}" bindtap="goBind">
    <text style="font-size: 13px; color: #94A3B8; line-height: 1.6;">尚未绑定守护对象，去「控制台」输入绑定码完成绑定 →</text>
  </view>

  <view class="card">
    <text class="title">📄 反诈报案电子维权材料</text>
    <text style="font-size: 12px; color: #94A3B8; margin-bottom: 12px; display: block;">数据实时抽取自后端 SQLite 数据库，可直接作为报案参考材料。</text>
    <button class="btn-primary" bindtap="onExportTap">一键复制报案材料文本</button>
  </view>

  <block wx:if="{{pkg}}">
    <!-- 受害者信息 -->
    <view class="card">
      <text class="card-title">【受害者信息】</text>
      <view class="evidence-row"><text class="evidence-key">老人姓名</text><text class="evidence-value">{{pkg.elder_info.name}}</text></view>
      <view class="evidence-row"><text class="evidence-key">联系电话</text><text class="evidence-value">{{pkg.elder_info.phone}}</text></view>
      <view class="evidence-row"><text class="evidence-key">监护人</text><text class="evidence-value">{{pkg.elder_info.guardian_name}}（{{pkg.elder_info.guardian_phone}}）</text></view>
    </view>

    <!-- 扣款流水 -->
    <view class="card">
      <text class="card-title">【扣款商户与交易流水】（{{pkg.payment_records.length || 0}} 笔）</text>
      <block wx:for="{{pkg.payment_records}}" wx:key="id">
        <view class="evidence-row">
          <text class="evidence-value payment-amount">¥{{item.amount}}</text>
          <text class="evidence-key">{{item.payee_name}}｜{{item.order_no}}</text>
        </view>
      </block>
      <text wx:if="{{!pkg.payment_records.length}}" class="evidence-empty">暂无扣款流水记录</text>
    </view>

    <!-- 可疑通话 -->
    <view class="card">
      <text class="card-title">【可疑通话记录】（{{pkg.suspicious_calls.length || 0}} 条）</text>
      <block wx:for="{{pkg.suspicious_calls}}" wx:key="id">
        <view class="evidence-block">
          <text class="evidence-value">{{item.event_type}} · {{item.created_at}}</text>
          <text class="evidence-key call-detail" wx:for="{{item.callDetails}}" wx:for-item="d" wx:key="*this">{{d}}</text>
        </view>
      </block>
      <text wx:if="{{!pkg.suspicious_calls.length}}" class="evidence-empty">暂无可疑通话记录</text>
    </view>

    <!-- 存证元数据 -->
    <view class="card">
      <text class="card-title">【存证元数据】</text>
      <view class="evidence-row"><text class="evidence-key">系统版本</text><text class="evidence-value">{{pkg.metadata.system_version}}</text></view>
      <view class="evidence-row"><text class="evidence-key">生成时间</text><text class="evidence-value">{{pkg.metadata.generated_at}}</text></view>
      <view class="evidence-row"><text class="evidence-key">存证校验码</text><text class="evidence-value">{{pkg.metadata.checksum}}</text></view>
    </view>
  </block>
</view>
