/* 维权证据页样式 */
.evidence-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.evidence-key {
  font-size: 12px;
  color: #94A3B8;
  text-align: right;
  flex: 1;
}

.evidence-value {
  font-size: 13px;
  color: #E2E8F0;
  flex: 1;
}

.payment-amount {
  color: #F87171;
  font-weight: bold;
  flex: none;
  margin-right: 16px;
}

.evidence-block {
  padding: 8px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.evidence-empty {
  font-size: 12px;
  color: #64748B;
  padding: 8px 0;
  display: block;
}

.call-detail {
  display: block;
  text-align: left;
  padding-left: 8px;
  line-height: 1.6;
}
