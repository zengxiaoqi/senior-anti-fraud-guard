<view class="container">
  <!-- 我的手机号（常驻）：换手机号后必须能改回来 -->
  <view class="card">
    <text class="card-title">📱 我的手机号</text>
    <text class="card-desc">
      老人端紧急警报会拨这个号码核实。{{myMobile ? '换了新号码请点下方修改，否则会拨到旧号码。' : '未填写则无法一键拨打。'}}
    </text>
    <view class="bind-info">
      <text class="bind-name">{{myMobile || '未填写'}}</text>
    </view>
    <button class="btn-primary" bindtap="onEditMobileTap">{{myMobile ? '修改手机号' : '填写手机号'}}</button>
  </view>

  <!-- 绑定状态卡片 -->
  <view class="card" wx:if="{{!isBound}}">
    <text class="card-title">🔗 亲情绑定</text>
    <text class="card-desc">请输入老人端显示的6位绑定码完成绑定</text>
    <input class="bind-input" type="number" maxlength="6" placeholder="请输入6位绑定码" bindinput="onBindCodeInput" />
    <button class="btn-primary" bindtap="onBindTap">绑定</button>
  </view>

  <view class="card" wx:if="{{isBound}}">
    <text class="card-title">✅ 已绑定被守护老人</text>
    <view class="bind-info">
      <text class="bind-name">{{boundUser.name}}</text>
      <text class="bind-phone">{{boundUser.phone}}</text>
    </view>
    <button class="btn-danger" bindtap="onUnbindTap">解除绑定</button>
  </view>

  <!-- 敏感地点守护入口 -->
  <view class="card" wx:if="{{isBound}}">
    <text class="card-title">📍 敏感地点守护</text>
    <text class="card-desc">登记可疑地点（如保健品讲座场馆），老人进入后自动开启环境录音存证并向您推送高危告警。</text>
    <button class="btn-primary" bindtap="goGeofence">配置敏感地点围栏</button>
  </view>

  <!-- AI 风险扫描 -->
  <view class="card">
    <text class="card-title">🤖 AI 风险扫描</text>
    <text class="card-desc">把可疑短信、宣传单文案粘贴到下面，AI 帮你识别是否为诈骗话术</text>
    <textarea
      class="scan-textarea"
      placeholder="例如：恭喜您被选中参加免费养生讲座，购买磁疗仪器可享高额收益返还..."
      placeholder-class="scan-placeholder"
      bindinput="onScanInput"
      value="{{scanText}}">
    </textarea>
    <button class="btn-primary" bindtap="onScanTap" loading="{{scanning}}">开始扫描</button>

    <view wx:if="{{scanResult}}" class="scan-result {{scanResult.risk_level === 'HIGH' ? 'high' : 'safe'}}">
      <text class="scan-level">{{scanResult.risk_level === 'HIGH' ? '🚨 高风险' : '✅ 未发现已知风险'}}（置信度 {{scanResult.confidence}}）</text>
      <text class="scan-report">{{scanResult.analysis_report}}</text>
      <text wx:if="{{scanResult.matched_keywords.length}}" class="scan-keywords">命中关键词：{{scanResult.matched_keywords}}</text>
      <text class="scan-action">建议：{{scanResult.suggested_action}}</text>
    </view>
  </view>

  <!-- 原有内容 -->
  <view class="card">
    <text class="card-title">📊 控制台概览</text>
    <view class="stats">
      <view class="stat-item">
        <text class="stat-value">{{events.length}}</text>
        <text class="stat-label">风险事件</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{locations.length}}</text>
        <text class="stat-label">轨迹点</text>
      </view>
    </view>
  </view>
</view>
