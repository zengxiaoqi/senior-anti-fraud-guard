.status-card {
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.15), rgba(16, 185, 129, 0.1));
}

.status-header {
  display: flex;
  align-items: center;
  gap: 16px;
}

.elder-avatar {
  font-size: 48px;
}

.elder-meta {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.elder-name {
  font-size: 18px;
  font-weight: bold;
  color: #FFFFFF;
}

.elder-detail {
  font-size: 12px;
  color: #94A3B8;
}

.connection-badge {
  display: inline-flex;
  padding: 2px 10px;
  border-radius: 12px;
  font-size: 11px;
  margin-top: 4px;
}

.connection-badge.online {
  background: rgba(16, 185, 129, 0.2);
  color: #34D399;
}

.connection-badge.offline {
  background: rgba(239, 68, 68, 0.2);
  color: #F87171;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
  margin-top: 12px;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.stat-num {
  font-size: 28px;
  font-weight: bold;
  color: #FFFFFF;
}

.stat-item.high .stat-num { color: #EF4444; }
.stat-item.medium .stat-num { color: #F59E0B; }
.stat-item.low .stat-num { color: #10B981; }

.stat-label {
  font-size: 11px;
  color: #94A3B8;
}

.actions-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 12px;
}

.action-btn {
  flex: 1;
  min-width: 45%;
  height: 44px;
  line-height: 44px;
  border-radius: 10px;
  font-size: 14px;
  font-weight: bold;
  color: #FFFFFF;
}

.action-btn.danger { background: #EF4444; }
.action-btn.primary { background: #3B82F6; }
.action-btn.info { background: #6366F1; }
.action-btn.success { background: #10B981; }

.filter-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.filter-picker {
  font-size: 13px;
  color: #3B82F6;
  padding: 4px 12px;
  border: 1px solid rgba(59, 130, 246, 0.3);
  border-radius: 8px;
}

.event-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 0;
  border-bottom: 1px solid rgba(255,255,255,0.05);
}

.event-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.event-type {
  font-size: 14px;
  font-weight: bold;
}

.event-time {
  font-size: 11px;
  color: #64748B;
}

.event-severity {
  font-size: 10px;
  padding: 2px 8px;
  border-radius: 10px;
  color: #FFFFFF;
}

.empty-state {
  text-align: center;
  color: #64748B;
  font-size: 13px;
  padding: 24px 0;
}

.bind-input {
  width: 100%;
  height: 40px;
  border: 1px solid #334155;
  border-radius: 8px;
  padding: 0 12px;
  margin: 12px 0;
  background: #0F172A;
  color: #F1F5F9;
  text-align: center;
  font-size: 18px;
  letter-spacing: 8px;
}

.bind-info {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin: 12px 0;
  padding: 12px;
  background: rgba(59, 130, 246, 0.1);
  border-radius: 8px;
}

.bind-name {
  font-size: 16px;
  font-weight: bold;
  color: #3B82F6;
}

.bind-phone {
  font-size: 13px;
  color: #94A3B8;
}

/* AI 风险扫描 */
.scan-textarea {
  width: 100%;
  min-height: 80px;
  border: 1px solid #334155;
  border-radius: 8px;
  padding: 10px 12px;
  margin: 12px 0;
  background: #0F172A;
  color: #F1F5F9;
  font-size: 13px;
  box-sizing: border-box;
}

.scan-result {
  margin-top: 12px;
  padding: 12px;
  border-radius: 8px;
  font-size: 13px;
  line-height: 1.6;
}

.scan-result.safe {
  background: rgba(16, 185, 129, 0.12);
  border: 1px solid rgba(16, 185, 129, 0.4);
}

.scan-result.high {
  background: rgba(239, 68, 68, 0.12);
  border: 1px solid rgba(239, 68, 68, 0.4);
}

.scan-level {
  font-size: 15px;
  font-weight: bold;
  margin-bottom: 6px;
  display: block;
}

.scan-result.safe .scan-level { color: #34D399; }
.scan-result.high .scan-level { color: #F87171; }

.scan-report {
  color: #E2E8F0;
  display: block;
}

.scan-keywords {
  margin-top: 6px;
  color: #F59E0B;
  font-size: 12px;
  display: block;
}

.scan-action {
  margin-top: 6px;
  color: #94A3B8;
  font-size: 12px;
  display: block;
}
