/* ═══ 主卡：守护对象（视觉焦点，概览数据并入） ═══ */
.hero-card {
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.18), rgba(16, 185, 129, 0.10));
}

.hero-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.hero-label {
  display: block;
  font-size: 11px;
  color: #94A3B8;
  margin-bottom: 4px;
}

.hero-name {
  display: block;
  font-size: 22px;
  font-weight: bold;
  color: #FFFFFF;
  line-height: 1.3;
}

.hero-phone {
  display: block;
  font-size: 13px;
  color: #94A3B8;
  margin-top: 2px;
}

/* 低频危险操作降级：小胶囊文字，不再抢视觉焦点 */
.hero-unbind {
  flex-shrink: 0;
  font-size: 11px;
  color: #94A3B8;
  padding: 6rpx 20rpx;
  border: 1px solid rgba(148, 163, 184, 0.35);
  border-radius: 999rpx;
}

/* 多人绑定切换条：横向滚动的老人 chip，选中项高亮 */
.elder-switch {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
  overflow-x: auto;
}

.elder-chip {
  flex-shrink: 0;
  font-size: 12px;
  color: #94A3B8;
  padding: 8rpx 24rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(148, 163, 184, 0.30);
  border-radius: 999rpx;
}

.elder-chip.on {
  color: #FFFFFF;
  font-weight: bold;
  background: rgba(59, 130, 246, 0.35);
  border-color: rgba(59, 130, 246, 0.60);
}

/* 追加绑定入口：虚线胶囊，视觉上与"已绑定的老人"区分 */
.elder-chip.add {
  color: #94A3B8;
  border-style: dashed;
}

.hero-stats {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.hero-chip {
  flex: 1;
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
}

/* 可点击提示：右侧小箭头 + 按压态 */
.hero-chip-arrow {
  margin-left: auto;
  font-size: 15px;
  color: #64748B;
}

.hero-chip-hover {
  background: rgba(255, 255, 255, 0.12);
}

.hero-chip-num {
  font-size: 20px;
  font-weight: bold;
  color: #FFFFFF;
}

.hero-chip-label {
  font-size: 11px;
  color: #94A3B8;
}

/* ═══ 告警微信通知：标题行 + 状态 pill ═══ */
.notify-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.notify-title {
  margin-bottom: 0;
}

.notify-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 12px;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.notify-pill.on {
  color: #34D399;
  background: rgba(16, 185, 129, 0.12);
}

.notify-pill.off {
  color: #F87171;
  background: rgba(239, 68, 68, 0.12);
}

.notify-dot {
  font-size: 10px;
}

/* ═══ 低频入口收纳区：单行式 ═══ */
.entry-card {
  padding: 8rpx 24rpx;
}

.entry-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 8rpx;
}

.entry-divider {
  height: 1px;
  background: rgba(255, 255, 255, 0.08);
}

.entry-title {
  font-size: 15px;
  font-weight: 500;
  color: #E2E8F0;
}

.entry-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.entry-value {
  font-size: 13px;
  color: #94A3B8;
}

/* 行内小操作按钮：描边胶囊，与主按钮拉开层级 */
.entry-action {
  font-size: 12px;
  color: #60A5FA;
  padding: 6rpx 22rpx;
  border: 1px solid rgba(59, 130, 246, 0.4);
  border-radius: 999rpx;
}

.entry-arrow {
  font-size: 18px;
  color: #64748B;
}

/* ═══ 绑定码 / 手机号输入框 ═══ */
.bind-input {
  width: 100%;
  height: 40px;
  border: 1px solid #334155;
  border-radius: 8px;
  padding: 0 12px;
  margin: 12px 0;
  background: #0F172A;
  color: #F1F5F9;
  text-align: center;
  font-size: 18px;
  letter-spacing: 8px;
  box-sizing: border-box;
}

/* AI 风险扫描 */
.scan-photo-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 4rpx;
}

/* OCR 诊断行：真机排障时用户直接截图这行字 */
.ocr-diag {
  display: block;
  font-size: 10px;
  color: #64748B;
  margin: 4rpx 0 8rpx;
  word-break: break-all;
}

.scan-photo-btn {
  flex: 1;
  font-size: 13px !important;
}

.scan-textarea {
  width: 100%;
  min-height: 80px;
  border: 1px solid #334155;
  border-radius: 8px;
  padding: 10px 12px;
  margin: 12px 0;
  background: #0F172A;
  color: #F1F5F9;
  font-size: 13px;
  box-sizing: border-box;
}

/* ── AI 扫描结论横幅（饱和实底状态色，深浅主题都可辨识） ── */
.scan-wrap {
  margin-top: 12px;
}

.scan-verdict {
  border-radius: 12px;
  padding: 14px 16px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.scan-verdict.HIGH {
  background: #DC2626;
}

.scan-verdict.SAFE {
  background: #065F46;
}

.scan-verdict.UNKNOWN {
  background: #334155;
}

.scan-verdict-title {
  color: #FFFFFF;
  font-size: 15px;
  font-weight: bold;
}

.scan-verdict-detail {
  color: rgba(255, 255, 255, 0.85);
  font-size: 12px;
}

.scan-report {
  margin-top: 12px;
  color: #E2E8F0;
  font-size: 13px;
  line-height: 1.6;
  display: block;
}

.scan-keyword-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.scan-keyword-tag {
  font-size: 11px;
  color: #F59E0B;
  background: rgba(245, 158, 11, 0.15);
  border: 1px solid rgba(245, 158, 11, 0.4);
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}

.scan-reminder {
  margin-top: 10rpx;
  color: #94A3B8;
  font-size: 12px;
  line-height: 1.6;
  display: block;
}
