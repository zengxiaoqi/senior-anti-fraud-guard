.container {
  padding: 24rpx;
  background: #0F172A;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #1E293B;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card-title {
  color: #F1F5F9;
  font-size: 32rpx;
  font-weight: 600;
}

.card-desc {
  color: #94A3B8;
  font-size: 26rpx;
  line-height: 1.6;
}

.state-text {
  color: #F1F5F9;
  font-size: 26rpx;
  line-height: 1.6;
  word-break: break-all;
}

.state-warn {
  color: #F59E0B;
}

.action-btn-wrap {
  margin-top: 4rpx;
}

.btn-primary {
  background: #3B82F6;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.btn-primary::after {
  border: none;
}

.btn-danger {
  background: #7F1D1D;
  color: #FCA5A5;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.btn-danger::after {
  border: none;
}

.btn-disabled {
  opacity: 0.5;
}

.footnote {
  color: #64748B;
  font-size: 22rpx;
  line-height: 1.5;
}
