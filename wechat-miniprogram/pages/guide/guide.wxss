.section-tabs {
  display: flex;
  background: rgba(30, 41, 59, 0.8);
  border-radius: 12px;
  padding: 4px;
  margin-bottom: 16px;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 10px 0;
  font-size: 14px;
  color: #94A3B8;
  border-radius: 8px;
  transition: all 0.3s;
}

.tab-item.active {
  background: #3B82F6;
  color: #FFFFFF;
  font-weight: bold;
}

.section-content {
  animation: fadeIn 0.3s;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

.fraud-card {
  border-left-width: 4px;
  border-left-style: solid;
}

.fraud-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6px;
}

.fraud-name {
  font-size: 15px;
  font-weight: bold;
  color: #FFFFFF;
}

.fraud-tag {
  font-size: 10px;
  padding: 2px 8px;
  border-radius: 10px;
  color: #FFFFFF;
}

.fraud-desc {
  font-size: 13px;
  color: #94A3B8;
  line-height: 1.5;
}

.highlight-card {
  background: rgba(16, 185, 129, 0.1);
  border-color: rgba(16, 185, 129, 0.3);
}

.rhyme-box {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 12px;
  padding: 16px;
  background: rgba(16, 185, 129, 0.08);
  border-radius: 10px;
}

.rhyme-text {
  font-size: 16px;
  color: #34D399;
  font-weight: bold;
  text-align: center;
}

/* 紧急联系卡片：图标 + 名称/号码 左侧堆叠，右侧操作胶囊按钮。
   之前用 <button> 承载操作，微信 button 自带 ::after 边框/默认内边距/
   最小宽度，怎么覆盖都漏样式，索性换成 view 胶囊，彻底摆脱默认皮肤 */
.contact-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.contact-left {
  display: flex;
  align-items: center;
  gap: 16px;
  flex: 1;
  min-width: 0;
}

.contact-icon {
  font-size: 28px;
  flex: none;
}

.contact-main {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.contact-name {
  font-size: 15px;
  font-weight: bold;
  color: #FFFFFF;
}

.contact-number {
  font-size: 14px;
  color: #60A5FA;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.contact-btns {
  display: flex;
  gap: 10px;
  flex: none;
  margin-left: 10px;
}

.contact-btn {
  font-size: 12px;
  padding: 5px 14px;
  border-radius: 999px;
  line-height: 1.4;
  text-align: center;
}

.contact-btn.call {
  background: #10B981;
  color: #FFFFFF;
}

.contact-btn.copy {
  background: #334155;
  color: #93C5FD;
}

.contact-btn:active {
  opacity: 0.75;
}

.step-card {
  display: flex;
  gap: 16px;
  align-items: flex-start;
}

.step-num {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: #3B82F6;
  color: #FFFFFF;
  font-size: 16px;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.step-content {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.step-title {
  font-size: 15px;
  font-weight: bold;
  color: #FFFFFF;
}

.step-desc {
  font-size: 13px;
  color: #94A3B8;
  line-height: 1.5;
}

.warning-card {
  background: rgba(239, 68, 68, 0.08);
  border-color: rgba(239, 68, 68, 0.2);
}

.warning-item {
  font-size: 13px;
  color: #FCA5A5;
  padding: 6px 0;
  padding-left: 16px;
  position: relative;
}

.warning-item::before {
  content: '!';
  position: absolute;
  left: 0;
  color: #EF4444;
  font-weight: bold;
}

.share-btn {
  margin-top: 16px;
  width: 100%;
}
