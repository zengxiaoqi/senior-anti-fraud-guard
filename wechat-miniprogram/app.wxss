/* 微信小程序全局 Dark Mode 样式 */
page {
  background-color: #0F172A;
  color: #F8FAFC;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  padding: 16px;
  box-sizing: border-box;
}

.card {
  background: rgba(30, 41, 59, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 16px;
  padding: 16px;
  margin-bottom: 16px;
}

.title {
  font-size: 16px;
  font-weight: bold;
  margin-bottom: 12px;
  display: flex;
  align-items: center;
}

.btn-danger {
  background-color: #EF4444;
  color: #FFFFFF;
  border-radius: 10px;
  font-weight: bold;
  font-size: 15px;
}

.btn-primary {
  background-color: #3B82F6;
  color: #FFFFFF;
  border-radius: 10px;
  font-weight: bold;
  font-size: 15px;
}
