<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/appBg">

    <!-- 顶部操作栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="返回"
            android:backgroundTint="#334155"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="风险记录与存证"
            android:textColor="?attr/appText"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <Button
            android:id="@+id/btn_export_text"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="导出"
            android:backgroundTint="#3B82F6"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_clear"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="清除"
            android:backgroundTint="#DC2626"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 分类筛选横向滚动 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/filter_all"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="全部"
                android:textSize="11sp"
                android:backgroundTint="#3B82F6"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/filter_payment"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="💳 大额扣款"
                android:textSize="11sp"
                android:backgroundTint="?attr/appCard"
                android:textColor="?attr/appTextDim"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/filter_call"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="📞 通话风险"
                android:textSize="11sp"
                android:backgroundTint="?attr/appCard"
                android:textColor="?attr/appTextDim"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/filter_sos"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🆘 紧急求助/打断"
                android:textSize="11sp"
                android:backgroundTint="?attr/appCard"
                android:textColor="?attr/appTextDim"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/filter_location"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="📍 位置轨迹"
                android:textSize="11sp"
                android:backgroundTint="?attr/appCard"
                android:textColor="?attr/appTextDim" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tv_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="共 0 条记录"
        android:textColor="?attr/appTextDim"
        android:textSize="12sp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="暂无符合条件的风险事件记录"
        android:textColor="?attr/appTextDim"
        android:textSize="14sp"
        android:gravity="center"
        android:paddingTop="48dp" />

    <ListView
        android:id="@+id/lv_risk_events"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="#1E293B"
        android:dividerHeight="1dp" />

</LinearLayout>
