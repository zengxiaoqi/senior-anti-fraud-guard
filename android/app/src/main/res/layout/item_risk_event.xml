<?xml version="1.0" encoding="utf-8"?>
<!--
  风险记录列表项（老人端）2026-10-11 改版。

  与子女端 item_family_event 是同一张"色条卡片"规格（复用 bg_card + bg_sev_bar），
  只按 ui-guidelines §0「两套受众两套密度」放大字号与内边距 —— 这是老人端，
  15sp 的标题在老人机上偏小，且会随全局字体三档再放大，写死小字号等于自我否定。

  2026-10-11：详情行改为走 EventLabels.formatDetails(forElder=true) 的人话，
  不再是 details 原始 JSON；色条高度改 match_parent（旧版写死 56dp，
  详情两行时色条会短一截，视觉上不像同一张卡）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_card"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="5dp">

    <!-- 严重度色条：红/黄/绿由代码设置，与右侧级别文字同色 -->
    <View
        android:id="@+id/v_sev_bar"
        android:layout_width="5dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_sev_bar" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_event_type"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="事件类型"
                android:textColor="?attr/appText"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_event_severity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="高危"
                android:textColor="#EF4444"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingStart="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_event_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="今天 12:00"
            android:textColor="?attr/appTextDim"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tv_event_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="详情"
            android:textColor="?attr/appText"
            android:textSize="15sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginTop="6dp"
            android:maxLines="4"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
