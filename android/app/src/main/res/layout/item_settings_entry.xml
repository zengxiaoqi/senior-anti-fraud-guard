<?xml version="1.0" encoding="utf-8"?>
<!--
  设置入口行（两端「防护规则设置 / 守护设置」入口页共用）。

  为什么单独抽一个 item 而不是在入口页里手写 4 遍：
  入口页的价值**全在摘要那一行** —— 用户是扫一眼"现在是什么状态"来决定
  要不要点进去的。四行手写必然漂成四种间距/字号，摘要也容易被某行漏掉，
  漏掉的那一项就退化成"一个不知道通向哪的按钮"。

  行高 ≥ 72dp：老人端要求触控目标大而整行可点，不是只有箭头那 20dp 能点。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_settings_entry"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_theme"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/entry_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_icon_box"
        android:gravity="center"
        android:text="⚙️"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/entry_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="标题"
            android:textColor="?attr/appText"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/entry_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="正在读取…"
            android:textColor="?attr/appTextDim"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/entry_chevron"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="›"
        android:textColor="?attr/appTextDim"
        android:textSize="26sp" />
</LinearLayout>
