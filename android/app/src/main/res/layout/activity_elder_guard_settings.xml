<?xml version="1.0" encoding="utf-8"?>
<!--
  子女端「守护设置」入口页。

  改造前这一页同时容纳家基准 + 8 个输入框 + 6 个档位 chip + 一个总保存按钮，
  滚到底要划四屏。真正的代价不是"长"，而是：
    1. 用户在末尾点保存时，看不见前面家基准那一栏填了什么 —— 保存的是一整屏记不住的状态；
    2. 某一项填错了，错误提示和它相距三屏，提示等于没有；
    3. 「清除家基准」只能标记、必须滚到底点保存才生效，
       于是"我明明清除了"成为一类无法复现的 bug。
  现在这一页只回答"每一项现在是什么状态"，改哪一项就进哪一项。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/appBg">

    <include
        android:id="@+id/topbar"
        layout="@layout/layout_settings_topbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/tv_hub_intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="这些参数决定老人手机什么时候告警。点进去改哪一项，就只改那一项，改完立即同步到老人手机。"
                android:textColor="?attr/appTextDim"
                android:textSize="13sp" />

            <include
                android:id="@+id/entry_home_base"
                layout="@layout/item_settings_entry" />

            <include
                android:id="@+id/entry_location"
                layout="@layout/item_settings_entry"
                android:layout_marginTop="10dp" />

            <include
                android:id="@+id/entry_call_payment"
                layout="@layout/item_settings_entry"
                android:layout_marginTop="10dp" />

            <include
                android:id="@+id/entry_recording"
                layout="@layout/item_settings_entry"
                android:layout_marginTop="10dp" />

            <include
                android:id="@+id/entry_fall"
                layout="@layout/item_settings_entry"
                android:layout_marginTop="10dp" />

            <include
                android:id="@+id/entry_ad_skip"
                layout="@layout/item_settings_entry"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/tv_hub_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="4dp"
                android:text=""
                android:textColor="?attr/appDangerTextStrong"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="4dp"
                android:text="每一项单独保存，互不影响。保存失败时该页会明确告知原因，不会显示成已保存 —— 老人手机仍在按原来的参数守护。"
                android:textColor="?attr/appTextDim"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
