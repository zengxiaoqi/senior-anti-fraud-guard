<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚨 防诈告警"
        android:textColor="?attr/appText"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_alerts_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="老人端上报的风险事件实时列表"
        android:textColor="?attr/appTextDim"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btn_interrupt"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_btn_danger"
        android:text="⚡ 紧急打断：提醒老人终止异常通话"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_alerts_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:text="暂无风险事件\n绑定老人后，这里会实时展示风险动态"
        android:textColor="?attr/appTextDim"
        android:textSize="14sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/lv_alert_events"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp"
        android:divider="@null"
        android:dividerHeight="8dp" />

</LinearLayout>
