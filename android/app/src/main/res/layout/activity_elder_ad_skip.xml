<?xml version="1.0" encoding="utf-8"?>
<!--
  老人端「防护规则设置 › 拦截开屏广告」。

  两件互相独立的事必须同时可见：功能开关（本页）与系统授权（无障碍）。
  只显示开关会让"开关开着但没授权"表现得和功能正常一模一样。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/appBg">

    <include
        android:id="@+id/topbar"
        layout="@layout/layout_settings_topbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="打开其他软件时，开头常有几秒广告，不小心点一下就跳进广告页面。开启后，会自动帮您点掉「跳过」按钮。"
                android:textColor="?attr/appTextDim"
                android:textSize="14sp" />

            <!-- 开关卡 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_theme"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="拦截开屏广告"
                    android:textColor="?attr/appText"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:lineSpacingExtra="3dp"
                        android:text="自动点击「跳过 / 跳过广告 / 跳过 5」这类按钮"
                        android:textColor="?attr/appText"
                        android:textSize="14sp" />

                    <Switch
                        android:id="@+id/sw_enabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="只点「跳过」类按钮，不碰其他任何内容。没带跳过按钮的广告挡不住。"
                    android:textColor="?attr/appTextDim"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 无障碍授权提示卡（开关开但未授权时才显示） -->
            <LinearLayout
                android:id="@+id/card_permission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_theme"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ 还需要一步"
                    android:textColor="?attr/appWarnTextStrong"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_permission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="?attr/appText"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_grant"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_btn_primary"
                    android:text="去系统设置开启无障碍"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="3dp"
                    android:text="如果跳转后找不到，请在系统设置里搜索「无障碍」，在已下载的应用里选「长者防诈守护」。"
                    android:textColor="?attr/appTextDim"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 拦截情况卡 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_theme"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="拦截情况"
                    android:textColor="?attr/appText"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="?attr/appText"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_last"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="?attr/appTextDim"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_test"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_btn_tonal"
                    android:text="测试拦截效果"
                    android:textColor="#3B82F6"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="3dp"
                android:text="这个开关也可以由子女在「守护设置」里代开。开关只控制要不要自动点击，授权状态只能在老人手机上开启。"
                android:textColor="?attr/appTextDim"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
