<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_login_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:text="🔐 子女端登录"
            android:textColor="?attr/appText"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="28dp"
            android:text="登录后即可远程守护老人"
            android:textColor="?attr/appTextDim"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="服务器地址"
            android:textColor="?attr/appText"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_server_url"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:hint="默认 https://guard.chataifree.eu.org ，自建填 IP:3000"
            android:textColor="?attr/appText"
            android:textColorHint="#94A3B8"
            android:inputType="textUri"
            android:paddingHorizontal="12dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_test_connection"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:backgroundTint="#00000000"
            android:stateListAnimator="@null"
            android:text="🔗 测试服务器连接"
            android:textColor="#1D4ED8"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="用户名（4-20位字母/数字/下划线，或手机号）"
            android:textColor="?attr/appText"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_username"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:hint="用户名或手机号"
            android:textColor="?attr/appText"
            android:textColorHint="#94A3B8"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="密码（至少6位）"
            android:textColor="?attr/appText"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_password"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:hint="请输入密码"
            android:textColor="?attr/appText"
            android:textColorHint="#94A3B8"
            android:inputType="textPassword"
            android:paddingHorizontal="12dp"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/label_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="手机号 *（必填，紧急时一键拨给子女）"
            android:textColor="?attr/appText"
            android:textSize="13sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/et_phone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:hint="11 位手机号（必填）"
            android:textColor="?attr/appText"
            android:textColorHint="#94A3B8"
            android:inputType="phone"
            android:maxLength="13"
            android:paddingHorizontal="12dp"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/label_nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="昵称（如：张强(儿子)）"
            android:textColor="?attr/appText"
            android:textSize="13sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/et_nickname"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:hint="如：张强(儿子)"
            android:textColor="?attr/appText"
            android:textColorHint="#94A3B8"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_login"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_btn_primary"
            android:text="登 录"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_register"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:text="没有账号？注册新账号"
            android:textColor="#1D4ED8"
            android:textSize="15sp"
            android:backgroundTint="#00000000"
            android:stateListAnimator="@null" />

        <TextView
            android:id="@+id/tv_login_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="#EF4444"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
