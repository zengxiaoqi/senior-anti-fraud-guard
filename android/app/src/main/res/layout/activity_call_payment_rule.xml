<?xml version="1.0" encoding="utf-8"?>
<!-- 子女端「守护设置 › 通话与支付」 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/appBg">

    <include
        android:id="@+id/topbar"
        layout="@layout/layout_settings_topbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_theme"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="先选一个档位"
                    android:textColor="?attr/appText"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="通话超过设定时长、单笔支出超过设定金额时向子女推送预警。宽松 = 更少打扰，严格 = 更快告警。"
                    android:textColor="?attr/appTextDim"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chip_call_relaxed"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_meta_box"
                        android:gravity="center"
                        android:text="宽松"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chip_call_standard"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_meta_box"
                        android:gravity="center"
                        android:text="标准"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chip_call_strict"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_meta_box"
                        android:gravity="center"
                        android:text="严格"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="点档位自动填入，下方仍可手动微调。"
                    android:textColor="?attr/appTextDim"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_theme"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="手动微调"
                    android:textColor="?attr/appText"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="通话预警时长（分钟）"
                    android:textColor="?attr/appText"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/et_call_threshold"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:hint="1~240"
                    android:inputType="number"
                    android:paddingHorizontal="12dp"
                    android:textColor="?attr/appInputText"
                    android:textColorHint="?attr/appTextDim"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="与陌生号码通话超过此时长，向子女发出高危告警。"
                    android:textColor="?attr/appTextDim"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="支付预警金额（元）"
                    android:textColor="?attr/appText"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/et_payment_threshold"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:hint="1~1000000"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:textColor="?attr/appInputText"
                    android:textColorHint="?attr/appTextDim"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="单笔支出超过此金额时同步给子女查看。"
                    android:textColor="?attr/appTextDim"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_btn_primary"
                android:text="保存通话与支付阈值"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="只保存本页这两项，其他守护参数不受影响。保存后会立即同步到老人手机。"
                android:textColor="?attr/appTextDim"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
