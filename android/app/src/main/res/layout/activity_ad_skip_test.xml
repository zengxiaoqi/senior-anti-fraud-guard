<?xml version="1.0" encoding="utf-8"?>
<!--
  「测试拦截效果」自检页：本地模拟开屏广告。

  按钮文案必须走「跳过 3 → 跳过 2 → 跳过 1 → 跳过」的真实倒计时形态：
  拦截服务匹配的是倒计时变体（AdSkipMatcher.COUNTDOWN），
  一上来就是「跳过」只能验证一半链路。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/appBg">

    <include
        android:id="@+id/topbar"
        layout="@layout/layout_settings_topbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="32dp">

            <!-- 模拟广告区 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:background="@drawable/bg_card_dark">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="模拟开屏广告"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="右上角有「跳过」按钮，和真广告一样"
                        android:textColor="#CCFFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_skip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_btn_tonal"
                    android:minHeight="40dp"
                    android:paddingHorizontal="16dp"
                    android:text="跳过 3"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="4dp"
                android:textColor="?attr/appText"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_retry"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_btn_tonal"
                android:text="再测一次"
                android:textColor="#3B82F6"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="3dp"
                android:text="如果拦截没生效，先检查上一页的开关，再检查系统设置里的无障碍授权。两项都对还点不掉，就是这台手机的 ROM 限制了本应用的无障碍权限。"
                android:textColor="?attr/appTextDim"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
