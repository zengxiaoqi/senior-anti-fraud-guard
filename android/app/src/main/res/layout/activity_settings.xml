<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️ 防护规则设置"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:lineSpacingExtra="4dp"
            android:padding="14dp"
            android:layout_marginTop="20dp"
            android:text="守护参数由子女在子女端 App 的「守护设置」里配置。这里只展示当前生效值，如需调整请让子女协助 —— 老人端保持只有一个写入方，避免两边改出矛盾。"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <!-- 通话阈值（只读展示） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="14dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="陌生电话预警时长阈值（分钟）"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="超过此时长与陌生号码通话时，自动向子女发出高危告警。默认：15 分钟"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />

            <!-- 只读展示：规则写入方收敛到子女端（单一写入方），老人端不再提供编辑 -->
            <TextView
                android:id="@+id/tv_call_threshold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#0F172A"
                android:padding="12dp"
                android:text="15"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- 支付阈值（只读展示） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="14dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="大额支付预警金额阈值（元）"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="单笔支付超过此金额时，自动同步给子女查看。默认：500 元"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tv_payment_threshold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#0F172A"
                android:padding="12dp"
                android:text="500"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- 录音段数（只读展示） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="14dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="单次连续录音最长时长（段）"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="每段时长在下方单独设置。必须有上限：老人按了 SOS 可能忘了这回事，没有上限会一直录下去把存储撑爆，长期录音也反而更难被采信。可填 1~6 段，默认 3 段。"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tv_rec_segments"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#0F172A"
                    android:padding="12dp"
                    android:text="3"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_rec_segment_minutes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="#0F172A"
                    android:padding="12dp"
                    android:text="5"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="左：连续录音最多几段（1~6）    右：每段几分钟（1~10，默认 5）"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tv_rec_minutes_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#10B981"
                android:textSize="12sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- 老人信息 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="14dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="老人姓名"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/et_elder_name"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="如：张爷爷"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:background="#0F172A"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="老人手机号（同步到服务器，子女端可见）"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/et_elder_phone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="11 位手机号"
                android:inputType="phone"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:background="#0F172A"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已绑定守护人姓名"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:layout_marginTop="12dp" />

            <!-- 只读展示，不能编辑：守护人信息以服务器绑定关系为事实源。
                 早期这里是个可编辑输入框，用户随手改的名字会与服务器不一致，
                 下次同步又被覆盖回去，表现成"我明明填了怎么又变了"；
                 更糟的是它让人误以为在这里填一下就能绑定子女，实际并不能。 -->
            <TextView
                android:id="@+id/tv_family_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#0F172A"
                android:padding="12dp"
                android:text="未绑定子女账号"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="由子女端绑定后自动显示，换手机也不会丢；如需改名请在子女端账号中操作。"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="以上防护规则会同步到云端，换手机、重装 App 后自动恢复，不会悄悄回到默认值。"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:layout_marginTop="12dp" />

        <!-- ══════════ 守护健康自检（Phase 0）══════════
             守护失效几乎全是静默的：界面显示"守护中"，实际某个必要权限没给
             或服务被系统杀了，除了这里把真实状态摊开，没有任何办法发现。
             出事之后，这份状态就是判断"当时到底有没有在跑"的唯一依据。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="14dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🩺 守护健康自检"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_health_report"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#0F172A"
                android:padding="12dp"
                android:text="正在检测…"
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp" />

            <TextView
                android:id="@+id/tv_health_advice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FBBF24"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btn_refresh_health"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="重新检测"
                android:backgroundTint="#334155"
                android:textColor="#E2E8F0"
                android:layout_marginTop="12dp" />

            <!-- 每个按钮对应一个"静默失效"的开关，跳转后必须回检（onResume 会自动刷新） -->
            <Button
                android:id="@+id/btn_fix_battery"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="① 关闭系统电池优化（防后台被杀）"
                android:backgroundTint="#334155"
                android:textColor="#E2E8F0"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btn_fix_background_location"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="② 位置权限改为「始终允许」"
                android:backgroundTint="#334155"
                android:textColor="#E2E8F0"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btn_fix_call_screening"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="③ 设为来电显示/骚扰拦截应用"
                android:backgroundTint="#334155"
                android:textColor="#E2E8F0"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btn_fix_notification_access"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="④ 开启通知使用权（用于监听扣款）"
                android:backgroundTint="#334155"
                android:textColor="#E2E8F0"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btn_fix_vendor"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="⑤ 自启动 / 后台弹出界面（厂商设置）"
                android:backgroundTint="#334155"
                android:textColor="#E2E8F0"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btn_fix_usage_access"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="⑥ 使用情况访问（通话中打开支付App联动）"
                android:backgroundTint="#334155"
                android:textColor="#E2E8F0"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_save_settings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="保存设置"
            android:backgroundTint="#10B981"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <!-- ══════════ 版本与升级 ══════════
             本 App 不进应用商店，装到老人手机上的版本如果不主动升级，
             就会永远停在半年前 —— 修好的守护能力在他们手机上从未生效过。
             这里是唯一的自升级入口：查版本 → 下载 → 校验 → 交给系统安装。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="14dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⬆️ 版本与升级"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_app_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="当前版本：检测中…"
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tv_update_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FBBF24"
                android:textSize="12sp"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp" />

            <Button
                android:id="@+id/btn_check_update"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="检查更新"
                android:backgroundTint="#334155"
                android:textColor="#E2E8F0"
                android:layout_marginTop="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="升级包约 23MB，弱网下需要几分钟。首次升级系统会要求授权「允许安装未知应用」，按提示打开一次即可，之后不再询问。"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
