<?xml version="1.0" encoding="utf-8"?>
<!--
  老人端「防护规则设置」入口页。

  改造前这一页同时塞了：只读守护参数（3 张卡）+ 资料填写 + 守护健康自检（6 个修复按钮
  + 两屏状态文本）+ 版本与升级，滚到底要划五屏。真正的代价不是"长"：
    1. 老人填完姓名，要滚过一整屏自检面板才能找到「保存设置」——
       按钮在屏幕外时，最常见的结局是他以为填好了（其实根本没提交）；
    2. 「版本与升级」在 AppSettingsActivity 里另有一份完整实现，
       两处都能升级，且两处显示的升级说明文案已经开始不一致。
  现在这一页只回答"有哪些项、每项现在什么状态"，改哪一项就进哪一项。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/appBg">

    <include
        android:id="@+id/topbar"
        layout="@layout/layout_settings_topbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="下面每一项都有单独的页面，点进去改哪一项就只改那一项。"
                android:textColor="?attr/appTextDim"
                android:textSize="14sp" />

            <include
                android:id="@+id/entry_profile"
                layout="@layout/item_settings_entry" />

            <include
                android:id="@+id/entry_guard_params"
                layout="@layout/item_settings_entry"
                android:layout_marginTop="10dp" />

            <include
                android:id="@+id/entry_health"
                layout="@layout/item_settings_entry"
                android:layout_marginTop="10dp" />

            <include
                android:id="@+id/entry_version"
                layout="@layout/item_settings_entry"
                android:layout_marginTop="10dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
