<?xml version="1.0" encoding="utf-8"?>
<!--
  子女端「守护设置 › 拦截开屏广告」。

  重点在保存按钮下方那段：开关只是让老人手机"愿意点"，
  系统无障碍授权才是"能点"，而授权只能在老人手机上完成。
  不写这一段，子女保存成功后会以为功能已经在工作。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/appBg">

    <include
        android:id="@+id/topbar"
        layout="@layout/layout_settings_topbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_theme"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="拦截开屏广告"
                    android:textColor="?attr/appText"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:lineSpacingExtra="3dp"
                        android:text="自动点击其他 App 开屏时的「跳过 / 跳过广告 / 跳过 5」按钮"
                        android:textColor="?attr/appText"
                        android:textSize="14sp" />

                    <Switch
                        android:id="@+id/sw_enabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="只点「跳过」类按钮，不操作其他任何内容；没带跳过按钮的广告挡不住。拦截次数只存在老人手机上，不在这里显示。"
                    android:textColor="?attr/appTextDim"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_theme"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="还需要老人手机做一步"
                    android:textColor="?attr/appText"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="3dp"
                    android:text="保存后请让老人在手机上操作一次：设置 → 无障碍 → 长者防诈守护 → 开启。\n\n老人端的「防护规则设置 › 拦截开屏广告」页面里有直达按钮，按提示打开即可。"
                    android:textColor="?attr/appText"
                    android:textSize="14sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_btn_primary"
                android:text="保存并同步到老人手机"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="只保存本页这一项，其他守护参数不受影响。保存后立即同步到老人手机。"
                android:textColor="?attr/appTextDim"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
