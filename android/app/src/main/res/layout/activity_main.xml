<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/appBg">

    <!-- 顶栏：设置入口常驻可见。
         以前「设置」藏在第二页最底部（前面还有绑定码、后端连接），
         等于没有 —— 老人找不到，子女远程指导也说不清"点哪里"。
         顶栏三个分页共用，任何一屏都能一跳进设置。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/appCard"
        android:paddingStart="16dp"
        android:paddingEnd="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🛡️ 防诈守护"
            android:textColor="?attr/appText"
            android:textSize="18sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <Button
            android:id="@+id/btn_app_settings"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="⚙️ 设置"
            android:textSize="15sp"
            android:textColor="?attr/appText"
            android:backgroundTint="?attr/appCardAlt"
            app:cornerRadius="12dp"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ═══════════ 第 1 页：首页 ═══════════ -->
        <ScrollView
            android:id="@+id/page_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- 顶部问候 -->
                <TextView
                    android:id="@+id/tv_home_greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="您好 👋"
                    android:textColor="?attr/appText"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="防诈守护助手，一直在您身边"
                    android:textColor="?attr/appTextDim"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp" />

                <!-- 防护总开关卡片 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_card_dark"
                    android:padding="18dp"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🛡️ 全天候防诈守护"
                            android:textColor="?attr/appText"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_service_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="检测中..."
                            android:textColor="?attr/appTextDim"
                            android:textSize="13sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

<com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/sw_guard_master"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:scaleX="1.25"
                            android:scaleY="1.25"
                            app:thumbTint="@android:color/white"
                            app:trackTint="@color/switch_track_elder" />
                    </LinearLayout>

                    <!-- 守护失效告警横幅（常驻，不可忽略）
                         为什么必须常驻而不是弹窗：2026-10-08 线上事故里，位置权限只有
                         「仅在使用中允许」，老人退出应用后位置上报永久停止 —— 而服务在跑、
                         通知栏在、界面全部显示正常，子女端也以为老人一直没动。
                         一次性的弹窗会被"知道了"关掉然后再也没人看见，正好是最容易
                         漏掉严重告警的形式。所以改成一直挂在首页，点一下直接去设置。 -->
                    <LinearLayout
                        android:id="@+id/ll_guard_alert"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#7F1D1D"
                        android:padding="14dp"
                        android:layout_marginTop="10dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tv_guard_alert_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🚨 守护未完全生效"
                            android:textColor="?attr/appText"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_guard_alert_body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#FECACA"
                            android:textSize="13sp"
                            android:layout_marginTop="6dp"
                            android:lineSpacingExtra="2dp" />

                        <Button
                            android:id="@+id/btn_guard_alert_fix"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:text="去修复"
                            android:backgroundTint="#DC2626"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:layout_marginTop="10dp" />

                        <Button
                            android:id="@+id/btn_guard_alert_more"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:text="查看全部 6 项状态"
                            android:backgroundTint="#7F1D1D"
                            android:textColor="#FECACA"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>

                <!-- SOS 一键紧急求助 -->
                <Button
                    android:id="@+id/btn_sos"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:text="🆘 一键紧急求助（SOS）"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:backgroundTint="#DC2626"
                    app:cornerRadius="18dp"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="20dp" />

                <!-- 录音存证状态卡片：录音中显示停止按钮，并提示待上传情况 -->
                <LinearLayout
                    android:id="@+id/ll_recording_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FEF2F2"
                    android:padding="14dp"
                    android:layout_marginTop="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_recording_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🔴 正在录音存证"
                        android:textColor="#B91C1C"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_recording_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="录音会自动保存并发送给子女"
                        android:textColor="#7F1D1D"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp" />

                    <Button
                        android:id="@+id/btn_stop_recording"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="⏹ 停止录音"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:backgroundTint="#FFFFFF"
                        android:textColor="#B91C1C"
                        app:cornerRadius="12dp"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:id="@+id/tv_upload_pending"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#92400E"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btn_retry_upload"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="📤 立即重试发送"
                        android:textSize="14sp"
                        android:backgroundTint="#F59E0B"
                        android:textColor="#FFFFFF"
                        app:cornerRadius="12dp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- AI 拍照识诈 -->
                <Button
                    android:id="@+id/btn_ai_scan"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:text="🤖 AI 拍照识诈（鉴别宣传单/短信）"
                    android:textSize="16sp"
                    android:backgroundTint="#7C3AED"
                    app:cornerRadius="16dp"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="12dp" />

                <!-- 查看风险记录 -->
                <Button
                    android:id="@+id/btn_view_logs"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="📋 查看风险事件记录"
                    android:textSize="15sp"
                    android:backgroundTint="?attr/appCard"
                    app:cornerRadius="16dp"
                    android:textColor="?attr/appText"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="遇到可疑电话/短信，先挂断，再到「防护指南」核实 ☝️"
                    android:textColor="?attr/appTextDim"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="16dp" />
            </LinearLayout>
        </ScrollView>

        <!-- ═══════════ 第 2 页：守护设置（分类归组） ═══════════ -->
        <ScrollView
            android:id="@+id/page_guard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- ── 分类① 权限管理 ── -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔐 权限管理"
                    android:textColor="?attr/appTextDim"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_dark"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="4dp"
                    android:layout_marginTop="8dp">

                    <!-- 扣款监听开关 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="大额扣款通知捕获"
                                android:textColor="?attr/appText"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/tv_notif_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="检测中..."
                                android:textColor="?attr/appTextDim"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/sw_notif_perm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            app:thumbTint="@android:color/white"
                            app:trackTint="@color/switch_track_elder" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/appCardAlt" />

                    <!-- 位置守护开关 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="位置感知守护"
                                android:textColor="?attr/appText"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/tv_location_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="检测中..."
                                android:textColor="?attr/appTextDim"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/sw_location_perm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            app:thumbTint="@android:color/white"
                            app:trackTint="@color/switch_track_elder" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/appCardAlt" />

                    <!-- 通话感知（系统级，只读行） -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="通话风险感知"
                                android:textColor="?attr/appText"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/tv_call_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Android 10+ 系统级支持"
                                android:textColor="#34D399"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="系统级 · 常开"
                            android:textColor="#60A5FA"
                            android:textSize="11sp"
                            android:background="@drawable/bg_input_dark"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ── 分类② 亲情绑定 ── -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔗 亲情绑定"
                    android:textColor="?attr/appTextDim"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="20dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_dark"
                    android:padding="16dp"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="绑定码（子女扫码/输入此码完成绑定）"
                        android:textColor="?attr/appTextDim"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:id="@+id/tv_bind_code"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="------"
                            android:textColor="#60A5FA"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.25" />

                        <Button
                            android:id="@+id/btn_copy_code"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="复制"
                            android:textSize="13sp"
                            android:backgroundTint="?attr/appCardAlt"
                            app:cornerRadius="12dp"
                            android:textColor="?attr/appText" />

                        <Button
                            android:id="@+id/btn_refresh_code"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="刷新"
                            android:textSize="13sp"
                            android:backgroundTint="#1E3A5F"
                            app:cornerRadius="12dp"
                            android:textColor="#93C5FD"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_bound_family"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="绑定状态：尚未绑定子女账号"
                        android:textColor="?attr/appTextDim"
                        android:textSize="13sp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- ── 分类③ 更多 ──
                     后端连接地址 / 修改手机号 / 切换角色 / 退出登录已统一搬到右上角 ⚙ 设置页：
                     这些都是"装好之后就再也不会碰"的操作，堆在首页第二页最底部时
                     既挤占了守护状态的空间，又让版本号这类真正要紧的信息沉底。 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙️ 更多"
                    android:textColor="?attr/appTextDim"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="20dp" />

                <Button
                    android:id="@+id/btn_settings"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="防护规则设置（预警阈值/老人资料）"
                    android:textSize="15sp"
                    android:backgroundTint="?attr/appCardAlt"
                    app:cornerRadius="16dp"
                    android:textColor="?attr/appText"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="版本升级、字体大小、界面风格、修改手机号、切换角色、退出登录、后端连接 —— 都在右上角 ⚙️ 里"
                    android:textColor="?attr/appTextDim"
                    android:textSize="13sp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="24dp" />
            </LinearLayout>
        </ScrollView>

        <!-- ═══════════ 第 3 页：防护指南（内容由代码构建） ═══════════ -->
        <ScrollView
            android:id="@+id/page_guide"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/ll_guide_elder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:paddingBottom="24dp" />
        </ScrollView>
    </FrameLayout>

    <!-- 底部菜单栏 -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/appCard"
        app:itemIconTint="@color/bottom_nav_item"
        app:itemTextColor="@color/bottom_nav_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_elder_bottom" />

</LinearLayout>
