<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider 允许对外授权的路径白名单。
     这里只放开 updates/ 一个目录：它是 App 私有目录（无需存储权限、不受分区存储限制），
     且里面只有我们刚下载并校验过的 APK。
     刻意不配 external-path / root-path —— 放开的范围越大，
     任何一个 content:// 泄露就越接近"整个存储可被读"。 -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="updates" path="updates/" />
    <!-- AI 识诈页拍照临时目录：TakePicture 需要把输出 URI 授权给系统相机 App 写入。
         cache/scan/ 只在识别瞬间存在一张照片，识别完成后照片不出手机、可被系统回收。 -->
    <cache-path name="scan" path="scan/" />
</paths>
