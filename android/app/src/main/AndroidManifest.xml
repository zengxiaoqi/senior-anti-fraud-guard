<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.antifraud.guard">

    <!-- 网络与通信权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- 电话与通话行为检测权限 -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    
    <!-- 前台守护服务与保活权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 环境录音存证（仅 SOS 求助 / 进入敏感地点围栏时触发） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 紧急打断：老人端后台/锁屏时以全屏意图通知弹出警报（Android 10+ 后台启动 Activity 限制的合规通道） -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    
    <!-- GPS 与后台位置感知权限 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.AntiFraudGuard">

        <!-- 高德原生地图 key（local.properties 配置 AMAP_KEY 后自动注入；留空则走内置 WebView 地图） -->
        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="${AMAP_API_KEY}" />

        <!-- 角色选择页（Launcher）：首次启动选择老人端 / 子女端 -->
        <activity
            android:name=".RoleSelectActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 主界面（老人端） -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- 子女端（App 版）登录页 -->
        <activity
            android:name=".FamilyLoginActivity"
            android:exported="false"
            android:label="子女端登录" />

        <!-- 子女端（App 版）主界面 -->
        <activity
            android:name=".FamilyHomeActivity"
            android:exported="false"
            android:label="子女端守护" />

        <!-- 子女端：敏感地点围栏管理 -->
        <activity
            android:name=".family.GeofenceManageActivity"
            android:exported="false"
            android:label="敏感地点守护" />

        <!-- 子女端：围栏地图选点器 -->
        <activity
            android:name=".family.MapPickerActivity"
            android:exported="false"
            android:label="地图选点" />

        <!-- 风险事件日志查看 -->
        <activity
            android:name=".RiskLogActivity"
            android:exported="false"
            android:label="风险事件记录" />

        <!-- 1. 前台常驻保活服务 -->
        <service
            android:name=".service.ForegroundGuardService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- 2. 通话行为检测 CallScreeningService (Android 10+) -->
        <service
            android:name=".service.CallScreeningGuardService"
            android:permission="android.permission.BIND_SCREENING_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- 3. 通知栏扣款/大额支付捕获服务 -->
        <service
            android:name=".service.NotificationPayListenerService"
            android:label="长者防诈支付安全监听"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- AI 拍照识诈页面 -->
        <activity
            android:name=".AiScanActivity"
            android:exported="false"
            android:label="AI 识诈鉴别" />

        <!-- 防护规则设置页面 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="防护规则设置" />

        <!-- 4. 位置守护感知服务 -->
        <service
            android:name=".service.LocationGuardService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- 5. 环境录音存证服务（SOS / 敏感地点围栏触发） -->
        <service
            android:name=".service.RecordingGuardService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- 全屏紧急强打断覆屏警报 -->
        <activity
            android:name=".EmergencyAlertActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop" />

    </application>
</manifest>
